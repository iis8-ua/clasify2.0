# Copiar este fichero a .env y ajustar los valores.
# .env NO se versiona (está en .gitignore). Este sí, para documentar qué variables existen.

# Servidor
PORT=3000

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=clasify_app
DB_PASSWORD=cambia-esta-contrasena
DB_NAME=clasify
DB_POOL_SIZE=10

# Base de datos usada por los tests de Jest
DB_TEST_NAME=clasify_test

# Autenticación
# Secreto con el que se firman los tokens JWT (HS256). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio
JWT_EXPIRES_IN=1h

# CORS: orígenes del frontend separados por comas. Por defecto se permiten los
# puertos de Vite (5173) y de `vite preview` (4173).
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4173

# Los usuarios de prueba del seed (ana@example.com y carlos@example.com) usan la
# contraseña fija Clasify123!. No hay variable para cambiarla: el hash está en
# src/db/seed.sql y se regenera con el comando que indica ese fichero.
